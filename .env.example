# ─── CureConnect AI Vision (server/ — never exposed to the browser) ───────────
# Placeholders only. Copy to .env for local use; set real values in the Render dashboard.
# Do NOT prefix these with VITE_ — that would put them in the public JS bundle.

# Google Gemini (the only AI provider). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Any current model that supports text + PDF/image input and JSON schema output.
GEMINI_MODEL=gemini-3.8-flash

# Access gate for /ai-lab. Code: at least 8 characters. Secret: at least 32 random characters
# (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Changing either value immediately signs everyone out.
AI_LAB_ACCESS_CODE=choose-a-long-access-code
AI_LAB_SESSION_SECRET=replace-with-64-hex-characters
AI_LAB_SESSION_HOURS=8

# Origin of the static site that proxies to this service (needed for POST requests through the proxy).
AI_LAB_ALLOWED_ORIGINS=https://cureconnect-dckr.onrender.com

# Usage limits (per session per hour, plus a global daily cap across everyone).
AI_LAB_CHAT_PER_HOUR=60
AI_LAB_REPORTS_PER_HOUR=10
AI_LAB_SUMMARIES_PER_HOUR=20
AI_LAB_DAILY_LIMIT=500
AI_LAB_MAX_UPLOAD_MB=10

# NODE_ENV=production enables Secure cookies and HSTS (set automatically in render.yaml).
# PORT is provided by Render.
